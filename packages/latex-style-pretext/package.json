{
  "name": "@pretextbook/latex-style-pretext",
  "version": "0.2.0",
  "description": "Editor intelligence (completions + validation) for LaTeX-style PreTeXt documents",
  "author": "Oscar Levin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PreTeXtBook/pretext-tools.git"
  },
  "bugs": {
    "url": "https://github.com/PreTeXtBook/pretext-tools/issues"
  },
  "homepage": "https://github.com/PreTeXtBook/pretext-tools/tree/main/packages/latex-style-pretext",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "README.md",
    "scripts/**/*",
    "src/**/*"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.lib.json",
    "typecheck": "tsc --build --emitDeclarationOnly",
    "test": "vitest run",
    "refresh-converter-support": "node ./scripts/refresh-converter-support.mjs"
  },
  "dependencies": {
    "vscode-languageserver-types": "^3.17.5"
  },
  "devDependencies": {
    "@pretextbook/latex-pretext": "*",
    "@pretextbook/unified-latex-to-pretext": "^0.0.8",
    "@unified-latex/unified-latex": "^1.8.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
